<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hulool.FormularyRestrictions</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Hulool 360° formulary restriction module: API, admin, analytics and seed data.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Seed\formulary-seed.json" LogicalName="Hulool.FormularyRestrictions.Seed.formulary-seed.json" />
  </ItemGroup>
</Project>
